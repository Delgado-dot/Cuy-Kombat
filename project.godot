; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cuy Kombat"
config/version="1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

ScreenFlow="*res://scripts/core/screen_flow.gd"
MusicManager="*res://scripts/core/music_manager.gd"
MutationManager="*res://scripts/systems/mutations/mutation_manager.gd"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720

[filesystem]

import/blender/enabled=false


[sub_resource type="Shader" id="ShaderAdoquinProcedural"]
code = "shader_type spatial;\nrender_mode diffuse_burley, specular_schlick_ggx;\n\nuniform vec3 stone_light : source_color = vec3(0.43, 0.405, 0.35);\nuniform vec3 stone_dark : source_color = vec3(0.315, 0.295, 0.255);\nuniform vec3 mortar : source_color = vec3(0.22, 0.205, 0.18);\nuniform float scale = 1.35;\n\nfloat hash21(vec2 p) {\n\tp = fract(p * vec2(123.34, 456.21));\n\tp += dot(p, p + 45.32);\n\treturn fract(p.x * p.y);\n}\n\nvoid fragment() {\n\tvec2 p = VERTEX.xz * scale;\n\tfloat row = floor(p.y);\n\tp.x += mod(row, 2.0) * 0.5;\n\tvec2 cell = floor(p);\n\tvec2 f = fract(p);\n\tfloat edge = min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y));\n\tfloat aa = max(fwidth(edge) * 1.6, 0.018);\n\tfloat joint = 1.0 - smoothstep(0.075 - aa, 0.075 + aa, edge);\n\tfloat n = hash21(cell);\n\tfloat broad = hash21(floor(VERTEX.xz * 0.42));\n\tfloat variation = clamp(0.38 + n * 0.36 + (broad - 0.5) * 0.14, 0.18, 0.82);\n\tvec3 stone = mix(stone_dark, stone_light, variation);\n\tALBEDO = mix(stone, mortar, joint * 0.82);\n\tROUGHNESS = mix(0.88, 0.98, joint);\n}\n"

[sub_resource type="ShaderMaterial" id="MatAdoquinProcedural"]
render_priority = 0
shader = SubResource("ShaderAdoquinProcedural")

[sub_resource type="Shader" id="ShaderCieloGradiente"]
code = "shader_type sky;\n\nvoid sky() {\n\tfloat h = clamp(EYEDIR.y * 0.5 + 0.5, 0.0, 1.0);\n\tvec3 horizon = vec3(0.47, 0.70, 0.82);\n\tvec3 zenith = vec3(0.055, 0.25, 0.55);\n\tCOLOR = mix(horizon, zenith, smoothstep(0.22, 0.92, h));\n}\n"

[sub_resource type="ShaderMaterial" id="MatCieloGradiente"]

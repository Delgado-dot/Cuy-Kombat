[sub_resource type="Shader" id="ShaderFondoVolcanico"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled;\n\nvoid fragment() {\n\tfloat altura = clamp(UV.y, 0.0, 1.0);\n\tfloat resplandor = 1.0 - smoothstep(0.02, 0.62, altura);\n\tvec3 oscuro = vec3(0.006, 0.006, 0.028);\n\tvec3 medio = vec3(0.035, 0.01, 0.065);\n\tvec3 profundo = vec3(0.15, 0.018, 0.006);\n\tvec3 color_base = mix(profundo, medio, smoothstep(0.0, 0.52, altura));\n\tcolor_base = mix(color_base, oscuro, smoothstep(0.45, 1.0, altura));\n\tALBEDO = color_base;\n\tEMISSION = color_base * (0.3 + resplandor * 0.72);\n}\n"

[sub_resource type="ShaderMaterial" id="MaterialFondoVolcanico"]
shader = SubResource("ShaderFondoVolcanico")

[sub_resource type="QuadMesh" id="MeshFondoVolcanico"]
material = SubResource("MaterialFondoVolcanico")
size = Vector2(140, 90)

[sub_resource type="Shader" id="ShaderNieblaRojiza"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, blend_mix, depth_draw_never;\n\nvoid fragment() {\n\tfloat borde_vertical = 1.0 - smoothstep(0.08, 0.9, UV.y);\n\tfloat desvanecer = smoothstep(0.0, 0.2, UV.y) * (1.0 - smoothstep(0.78, 1.0, UV.y));\n\tfloat bordes = smoothstep(0.0, 0.1, UV.x) * (1.0 - smoothstep(0.9, 1.0, UV.x));\n\tfloat ondas = 0.78 + sin(UV.x * 23.0 + UV.y * 7.0) * 0.08;\n\tvec3 color_niebla = mix(vec3(0.065, 0.008, 0.028), vec3(0.26, 0.028, 0.006), borde_vertical);\n\tALBEDO = color_niebla;\n\tEMISSION = color_niebla * 0.5;\n\tALPHA = clamp((0.035 + borde_vertical * 0.2) * ondas * desvanecer * bordes, 0.0, 0.24);\n}\n"


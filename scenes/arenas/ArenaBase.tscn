[sub_resource type="Shader" id="ShaderPisoAnular"]
code = "shader_type spatial;\n\nvarying vec3 posicion_local;\n\nfloat hash21(vec2 p) {\n\tp = fract(p * vec2(123.34, 456.21));\n\tp += dot(p, p + 45.32);\n\treturn fract(p.x * p.y);\n}\n\nvoid vertex() {\n\tposicion_local = VERTEX;\n}\n\nvoid fragment() {\n\tvec2 p = posicion_local.xz;\n\tfloat radio = length(p);\n\tfloat angulo = atan(p.y, p.x);\n\tfloat anillo = floor((radio - 3.0) * 1.08);\n\tfloat celda_anillo = fract((radio - 3.0) * 1.08);\n\tfloat borde_anillo = 1.0 - smoothstep(0.025, 0.075, min(celda_anillo, 1.0 - celda_anillo));\n\tfloat cantidad = 18.0 + mod(anillo, 2.0) * 4.0;\n\tfloat celda_angular = fract((angulo / 6.283185 + 0.5) * cantidad + mod(anillo, 2.0) * 0.5);\n\tfloat borde_angular = 1.0 - smoothstep(0.018, 0.052, min(celda_angular, 1.0 - celda_angular));\n\tfloat juntas = max(borde_anillo, borde_angular);\n\tfloat variacion = hash21(vec2(anillo, floor(celda_angular * cantidad))) * 0.065;\n\tfloat veta = sin(p.x * 1.7 + sin(p.y * 1.35) * 1.8) * 0.018;\n\tvec3 piedra_a = vec3(0.19, 0.105, 0.105);\n\tvec3 piedra_b = vec3(0.105, 0.062, 0.078);\n\tvec3 piedra = mix(piedra_a, piedra_b, clamp((radio - 3.0) / 6.0, 0.0, 1.0));\n\tpiedra += vec3(variacion + veta, variacion * 0.52, variacion * 0.42);\n\tpiedra = mix(piedra, vec3(0.025, 0.012, 0.018), juntas * 0.82);\n\tfloat grieta_base = abs(sin(angulo * 8.0 + sin(radio * 1.65) * 1.85));\n\tfloat grieta = 1.0 - smoothstep(0.018, 0.072, grieta_base);\n\tfloat corte = smoothstep(0.36, 0.68, sin(radio * 4.2 + angulo * 3.0) * 0.5 + 0.5);\n\tfloat lava = grieta * corte * (1.0 - juntas * 0.65);\n\tALBEDO = mix(piedra, vec3(0.38, 0.035, 0.004), lava * 0.72);\n\tEMISSION = vec3(1.0, 0.105, 0.008) * lava * 1.8;\n\tROUGHNESS = mix(0.98, 0.62, lava);\n}\n"


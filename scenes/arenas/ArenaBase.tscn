[sub_resource type="Shader" id="ShaderPisoAnular"]
code = "shader_type spatial;\n\nvarying vec3 posicion_local;\n\nvoid vertex() {\n\tposicion_local = VERTEX;\n}\n\nvoid fragment() {\n\tfloat variacion = sin(posicion_local.x * 1.35 + sin(posicion_local.z * 1.8)) * 0.008;\n\tvec3 arena_clara = vec3(0.34, 0.22, 0.09);\n\tALBEDO = arena_clara + vec3(variacion, variacion * 0.72, variacion * 0.38);\n\tROUGHNESS = 0.92;\n}\n"

[sub_resource type="ShaderMaterial" id="MaterialCremaAnular"]
render_priority = 0

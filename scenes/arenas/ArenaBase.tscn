[sub_resource type="Shader" id="ShaderBordeBloques"]
code = "shader_type spatial;\n\nvarying float angulo_local;\n\nvoid vertex() {\n\tangulo_local = atan(VERTEX.z, VERTEX.x);\n}\n\nvoid fragment() {\n\tfloat sector = fract((angulo_local + 3.14159265) / 6.2831853 * 24.0);\n\tfloat junta = smoothstep(0.015, 0.05, sector) * (1.0 - smoothstep(0.95, 0.985, sector));\n\tvec3 piedra_oscura = vec3(0.14, 0.02, 0.035);\n\tvec3 piedra_rojiza = vec3(0.34, 0.065, 0.09);\n\tALBEDO = mix(piedra_oscura, piedra_rojiza, junta);\n\tROUGHNESS = 0.9;\n}\n"

[sub_resource type="ShaderMaterial" id="MaterialBordeRosa"]
shader = SubResource("ShaderBordeBloques")


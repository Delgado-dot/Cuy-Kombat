[sub_resource type="Shader" id="ShaderLavaAbismo"]
code = "shader_type spatial;\nrender_mode blend_mix, depth_draw_never;\n\nvarying vec3 posicion_local;\n\nvoid vertex() {\n\tposicion_local = VERTEX;\n}\n\nvoid fragment() {\n\tvec2 p = posicion_local.xz;\n\tfloat radio = length(p);\n\tfloat onda_a = sin(p.x * 0.42 + TIME * 0.42 + sin(p.y * 0.31) * 2.1);\n\tfloat onda_b = sin(p.y * 0.55 - TIME * 0.3 + sin(p.x * 0.22) * 2.4);\n\tfloat onda_c = sin((p.x + p.y) * 0.28 + TIME * 0.22);\n\tfloat flujo = smoothstep(0.56, 0.9, (onda_a + onda_b + onda_c) * 0.1667 + 0.5);\n\tvec3 roca_fundida = vec3(0.085, 0.003, 0.002);\n\tvec3 lava = mix(vec3(0.42, 0.018, 0.001), vec3(0.92, 0.13, 0.003), flujo);\n\tfloat borde_suave = 1.0 - smoothstep(8.2, 11.5, radio);\n\tALBEDO = mix(roca_fundida, lava, flujo);\n\tEMISSION = lava * (0.42 + flujo * 1.28);\n\tROUGHNESS = 0.58;\n\tALPHA = borde_suave * (0.54 + flujo * 0.24);\n}\n"


[sub_resource type="Shader" id="ShaderPisoAnular"]
code = "shader_type spatial;\n\nvarying vec3 posicion_local;\n\nvoid vertex() {\n\tposicion_local = VERTEX;\n}\n\nvoid fragment() {\n\tfloat veta_larga = sin(posicion_local.x * 1.15 + sin(posicion_local.z * 1.6)) * 0.018;\n\tfloat veta_corta = sin((posicion_local.x + posicion_local.z) * 3.7) * 0.007;\n\tvec3 arena_clara = vec3(0.48, 0.285, 0.105);\n\tALBEDO = arena_clara + vec3(veta_larga + veta_corta, (veta_larga + veta_corta) * 0.62, (veta_larga + veta_corta) * 0.28);\n\tROUGHNESS = 0.94;\n}\n"


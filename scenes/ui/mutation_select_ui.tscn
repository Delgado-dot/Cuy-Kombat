[sub_resource type="Shader" id="Shader_backdrop"]
code = "shader_type canvas_item;\n\nfloat hash21(vec2 p) {\n\tp = fract(p * vec2(123.34, 456.21));\n\tp += dot(p, p + 45.32);\n\treturn fract(p.x * p.y);\n}\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tvec3 navy = vec3(0.006, 0.012, 0.035);\n\tvec3 wine = vec3(0.13, 0.012, 0.025);\n\tfloat horizon = 1.0 - smoothstep(0.2, 0.96, uv.y);\n\tfloat center_glow = exp(-length((uv - vec2(0.5, 0.54)) * vec2(1.25, 1.8)) * 3.2);\n\tvec3 color = mix(navy, wine, horizon * 0.62);\n\tcolor += vec3(0.15, 0.025, 0.01) * center_glow * 0.34;\n\tfloat vignette = 1.0 - smoothstep(0.28, 0.92, length((uv - 0.5) * vec2(1.0, 1.35)));\n\tvec2 ember_grid = uv * vec2(96.0, 54.0);\n\tvec2 ember_uv = fract(ember_grid) - 0.5;\n\tfloat cell = hash21(floor(ember_grid));\n\tfloat spark = 1.0 - smoothstep(0.035, 0.16, length(ember_uv));\n\tfloat ember = step(0.986, cell) * spark * (1.0 - smoothstep(0.28, 0.94, uv.y));\n\tcolor += vec3(1.0, 0.18, 0.015) * ember * (0.35 + 0.3 * sin(TIME * 1.7 + cell * 18.0));\n\tCOLOR = vec4(color * vignette, 0.94);\n}\n"

[sub_resource type="ShaderMaterial" id="Material_backdrop"]
shader = SubResource("Shader_backdrop")

